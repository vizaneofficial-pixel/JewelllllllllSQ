# Server-side Gemini API Key (required for AI Command Bar, CFO Audit, Voice Coach, Image Concept & Search)
GEMINI_API_KEY=

# Optional Firebase client overrides for Vercel / custom deployments
# In AI Studio these default to firebase-applet-config.json if omitted.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
